VW_BASE_URL=https://en.volleyballworld.com
VW_TIMEOUT_SECONDS=30
VW_REQUEST_INTERVAL_SECONDS=1.0
VW_CACHE_DIR=.cache/volleyball_world
VW_CACHE_TTL_HOURS=24
VW_USER_AGENT=volleyball-athlete-forecasting/0.1 (+replace-with-contact-email)

# Optional authorized JSON athlete-stat endpoint. The placeholders available are:
# {base_url}, {competition_slug}, {season}, and {player_id}.
VW_PLAYER_STATS_URL_TEMPLATE=
VW_PLAYER_STATS_MAPPING=config/vw-player-json-mapping.example.yaml

MODEL_DIR=artifacts/model
LOG_LEVEL=INFO
